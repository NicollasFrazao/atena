# dotcontext local state: harness, config, caches, sessions and plans. Only
# .context/docs, .context/agents and .context/skills are versioned.
.context/config.json
.context/config/
.context/harness/
.context/plans/
.context/runtime/
.context/cache/semantic/
.context/workflow/
.context/harness/sessions/
.context/harness/traces/
.context/harness/artifacts/
.context/harness/contracts/
.context/harness/workflows/
.context/harness/replays/
.context/harness/datasets/
.context/**/archive/

# secrets and environment variables
.env
.env.*
!.env.example

# Playwright MCP validation artifacts (snapshots, screenshots)
.playwright-mcp/
report-card.png

# Node / build
node_modules/
dist/
build/
*.tsbuildinfo
coverage/

# Playwright (web e2e): reports, artifacts and the browser cache
apps/web/playwright-report/
apps/web/test-results/
apps/web/blob-report/
.cache/ms-playwright/
# compiled output must never land next to the package sources
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
