# Atena — variáveis de ambiente (EXEMPLO). Copie para .env e preencha.
# NÃO commitar o .env (já está no .gitignore). Este .env.example é seguro (sem valores).

# --- AWS: acesso de leitura aos logs de envio (json.gz no S3) ---
# Para a análise dos top-3 cenários de anomalia (decisão #4).
# Use credenciais SOMENTE-LEITURA: s3:ListBucket + s3:GetObject no bucket de logs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ATENA_LOGS_BUCKET=at-api-logs-prod
ATENA_LOGS_PREFIX=

# ============================================================
# Runtime do app. O `.env` é GERADO EM RUNTIME e NUNCA versionado
# (produção: SSM/Secrets Manager; local: `make env` a partir deste template).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
# Fuso de exibição/janela (IANA). Edge de fuso: o motor é UTC; as datas que o operador escolhe
# (dias nomeados / presets) e vê são interpretadas/mostradas neste fuso. Trocar habilita outro fuso
# sem mudar código. API lê APP_TIMEZONE; o front (build-time) lê VITE_APP_TIMEZONE. Default: BRT.
APP_TIMEZONE=America/Sao_Paulo
VITE_APP_TIMEZONE=America/Sao_Paulo

# --- Banco MySQL (hot store de metadados + audit_log) ---
# host `mysql`  = serviço do docker-compose (API rodando NO Docker: `make up ENV=local`)
# host `127.0.0.1` = API rodando NO HOST (`npm run dev`) contra o MySQL publicado
DATABASE_URL="mysql://root:atena@mysql:3306/atena"

# --- LLM ---
# Provider ativo: 'fake' (dev/local, determinístico, SEM credencial) | 'bedrock' (produção).
LLM_PROVIDER=fake

# --- Amazon Bedrock (usado quando LLM_PROVIDER=bedrock; usa AWS_REGION/credenciais ou IAM role da EC2) ---
# Aponte para o Claude mais recente do seu Bedrock; confirme o id no catálogo da região.
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# --- S3: conteúdo bruto / origem durável (/tmp é só cache transitório) ---
ATENA_CONTENT_BUCKET=
ATENA_TMP_CACHE_DIR=/tmp/atena-cache

# --- Auth: login social institucional (OIDC). Provider plugável (default Microsoft 365 / Entra ID) ---
# Em DEV, AuthGuard resolve um usuário stub (com papéis) e NÃO exige login — desenvolvimento sem autenticação.
# Em PRODUÇÃO, defina AUTH_DEV_BYPASS=false (e configure o OIDC real abaixo).
AUTH_DEV_BYPASS=true
AUTH_PROVIDER=microsoft-entra
AUTH_ALLOWED_DOMAIN=example.com
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=

# --- Detector de anomalias (Fase 2) ---
# DETECT_ENABLED liga o scan agendado (@Interval). O gatilho dev POST /api/dev/detect roda mesmo desligado.
# DETECT_MIN_VOLUME: guarda de volume (mín. de terminais na janela). DEV baixo p/ disparar no seed; PRODUÇÃO ≥ 500.
# DETECT_BASELINE_WINDOWS: nº de janelas anteriores usadas no baseline (μ/σ) por cliente.
DETECT_ENABLED=false
DETECT_MIN_VOLUME=20
DETECT_BASELINE_WINDOWS=8
