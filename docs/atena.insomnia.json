      "_id": "sio_support",
      "_type": "socketio_request",
      "parentId": "fld_realtime",
      "name": "Socket.IO /ws/support (nativo — recomendado)",
      "url": "{{ _.base_url }}/ws/support",
      "headers": [],
      "authentication": {},
      "parameters": [],
      "description": "Connect e escute: incident.created / incident.updated / incident.auto_resolved.\nHandshake path padrão /socket.io/ (Request Settings). Dev: sem token (devBypass).\nO servidor faz o heartbeat do Engine.IO — a conexão fica de pé (diferente do WebSocket cru).",
      "eventListeners": [
        {
          "id": "evt-connection-status",
          "eventName": "connection.status",
          "desc": "Heartbeat/estado da conexão",
          "isOpen": false
        },
        {
          "id": "evt-incident-created",
          "eventName": "incident.created",
          "desc": "Novo incidente detectado",
          "isOpen": false
        },
        {
          "id": "evt-incident-updated",
          "eventName": "incident.updated",
          "desc": "Mudança de status (ack/resolve)",
          "isOpen": false
        },
        {
          "id": "evt-incident-auto-resolved",
          "eventName": "incident.auto_resolved",
          "desc": "Resolução automática",
          "isOpen": false
        }
      ],
      "settingEncodeUrl": true,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "metaSortKey": 2900
    },
