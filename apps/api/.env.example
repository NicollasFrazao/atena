# Atena API — referência de variáveis de ambiente
#
# O app lê SEMPRE um único `.env`, GERADO EM RUNTIME e NUNCA versionado (em produção via
# SSM/Secrets Manager; em local via `make env` a partir deste arquivo). Os valores abaixo são os
# DEFAULTS do código (em apps/api/src/config/configuration.ts) — só precisa setar o que divergir.
# NÃO comite segredos reais (DATABASE_URL, AWS_BEARER_TOKEN_BEDROCK, OIDC_CLIENT_SECRET, SESSION_SECRET).

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Fuso de exibição/janela do operador (IANA). O motor fica em UTC; converte só nos edges.
APP_TIMEZONE=America/Sao_Paulo

# ── Banco (Prisma/MySQL) ─────────────────────────────────────────────────────
DATABASE_URL=

# ── AWS / Bedrock / LLM ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
# LLM ativo: 'fake' (dev/local, determinístico, sem credencial) | 'bedrock' (produção).
LLM_PROVIDER=fake
# Modelo no Bedrock via inference profile (ex.: us.anthropic.claude-opus-4-...). Vazio → fake.
BEDROCK_MODEL_ID=
# OBRIGATÓRIO quando LLM_PROVIDER=bedrock (Bearer do Bedrock). Vazio → cai no fake provider.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MAX_TOKENS=1024

# ── S3 (buckets) ─────────────────────────────────────────────────────────────
ATENA_LOGS_BUCKET=
ATENA_LOGS_PREFIX=
ATENA_CONTENT_BUCKET=

# ── Motor de auditoria (DuckDB sobre S3) ─────────────────────────────────────
# Diretório do cache transitório read-through (volume persistido). Não é fonte de verdade.
ATENA_TMP_CACHE_DIR=/tmp/atena-cache
#
# Fonte + janela
# Detailed report de SMS. ATENA_AUDIT_SOURCE_ROOT vence; senão s3://${ATENA_SMS_STATUS_BUCKET}.
ATENA_AUDIT_SOURCE_ROOT=
ATENA_SMS_STATUS_BUCKET=
ATENA_AUDIT_DEFAULT_WINDOW_DAYS=30
# Data mínima de consulta (ISO): barra dados pré-contrato enriquecido; vazio desliga a guarda.
ATENA_AUDIT_MIN_QUERY_DATE=
#
# Vidas de cache / reconciliação
# Partição vira "settled" (cacheável) este tempo após fechar; recentes vão live.
ATENA_AUDIT_CACHE_SETTLE_MINUTES=60
# TTL do cache da partição RECENTE (não-settled). 0 desliga (sempre live).
ATENA_AUDIT_LIVE_CACHE_TTL_SECONDS=60
# Buffer do scan SÓ PRA FRENTE (capta desfecho que chega depois do envio). ~lag do detailed report.
ATENA_AUDIT_LATE_STATUS_BUFFER_HOURS=48
# Horizonte de LAG: partição settled DENTRO dele é reconciliada por LIST (lê só objetos novos); além, imutável.
ATENA_AUDIT_LAG_HOURS=48
# TTL do cache de registros por id (reveal/análise pós-busca não re-varrem o S3).
ATENA_AUDIT_RECORD_CACHE_TTL_MINUTES=30
# TTL dos snapshots de busca (Parquet do conjunto exato; export por token lê daqui).
ATENA_AUDIT_SNAPSHOT_TTL_MINUTES=60
#
# Tetos (memória / disco / retenção) — eviction do cache de eventos; 0 desliga cada limite.
ATENA_AUDIT_CACHE_MAX_MB=4096
ATENA_AUDIT_CACHE_MAX_AGE_HOURS=168
ATENA_AUDIT_RECORD_CACHE_MAX=10000
ATENA_AUDIT_SHIPPING_INDEX_MAX=20000
# Retenção dos eventos de scan persistidos (observabilidade); poda no eviction.
ATENA_AUDIT_SCAN_EVENT_RETENTION_DAYS=30
#
# Engine DuckDB / pré-fetch
# memory_limit (spill em disco ao exceder) e threads (concorrência de leitura dos objetos S3).
DUCKDB_MEMORY_LIMIT=3GB
DUCKDB_THREADS=8
# Concorrência do pré-fetch paralelo dos objetos S3 (Node/SDK). 0 desliga (lê via httpfs).
ATENA_AUDIT_PREFETCH_CONCURRENCY=32

# ── Detector de anomalias ────────────────────────────────────────────────────
# Liga o scan agendado (@Interval). O trigger manual POST /api/dev/detect roda independente disto.
DETECT_ENABLED=false
# Cadência do scan agendado (segundos).
DETECT_INTERVAL_SECONDS=180
# Guarda de volume (terminais): produção ≥ 500 (anomaly-scenarios.md); dev baixo p/ disparar no seed.
DETECT_MIN_VOLUME=20
# Janelas de lookback p/ o baseline (μ/σ) por cliente.
DETECT_BASELINE_WINDOWS=8

# ── Retenção do chat ─────────────────────────────────────────────────────────
# Job diário; =false desliga (default ligado).
CHAT_RETENTION_ENABLED=true
CHAT_RETENTION_DAYS=90

# ── Auth (OIDC — Microsoft Entra) ────────────────────────────────────────────
AUTH_PROVIDER=microsoft-entra
AUTH_ALLOWED_DOMAIN=example.com
# Dev/local: resolve usuário stub. Fail-closed: só liga com =true E NODE_ENV != production.
AUTH_DEV_BYPASS=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Segredo de assinatura do cookie de sessão (JWT). OBRIGATÓRIO em produção.
SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=8
# Origins do frontend (CSV). CORS_ORIGINS é a allowlist; WEB_ORIGIN (1º) é o destino do callback.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WEB_ORIGIN=http://localhost:5173
# Allowlist (CSV) de e-mails que recebem 'admin' no login (bootstrap do RBAC).
AUTH_ADMIN_EMAILS=

# ── Observabilidade (Datadog APM) — opcional ─────────────────────────────────
DD_TRACE_ENABLED=false
DD_AGENT_HOST=
DD_ENV=
DD_SERVICE=atena-api
