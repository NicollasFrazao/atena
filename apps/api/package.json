{
  "name": "@atena/api",
  "version": "0.0.0",
  "private": true,
  "description": "Atena's NestJS backend (LLM orchestrator, tools, REST and WebSocket)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "jest --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@atena/types": "*",
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@duckdb/node-api": "^1.5.4-r.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dd-trace": "^5.134.0",
    "hot-shots": "^16.0.0",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.8.0"
  }
}
